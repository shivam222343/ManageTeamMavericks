# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRY=86400

# Cloudinary Configuration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=official@teammavericks.org
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=official@teammavericks.org
SMTP_FROM_NAME=Team Mavericks

# Application Environment
FRONTEND_URL=http://localhost:5173
DISPLAY_ERRORS=false

# Redis Configuration (High-concurrency caching & autosave buffer)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# WebRTC SFU Proctoring Infrastructure
SFU_URL=wss://sfu.teammavericks.org
SFU_API_KEY=
SFU_API_SECRET=
